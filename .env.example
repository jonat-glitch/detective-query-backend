# Backend Environment Variables — Required for Deployment
# Copy this file to .env and fill in real values
# NEVER commit the actual .env to version control

# ── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_64_CHARS

# ── TiDB Cloud Database
DB_HOST=your-tidb-host.aws.tidbcloud.com
DB_USER=your-tidb-user
DB_PASSWORD=your-tidb-password
DB_NAME=detective_query
DB_PLAYGROUND_USER=your-tidb-user
DB_PLAYGROUND_PASSWORD=your-tidb-password
DB_PLAYGROUND_NAME=detective_query_playground
DB_PORT=4000
DB_SSL=true

# ── Email (Brevo REST API)
BREVO_API_KEY=xkeysib-your-brevo-key
MAIL_USER=your-email@gmail.com
MAIL_FROM="Detective Query" <your-email@gmail.com>

# ── Frontend URL (used in email buttons)
APP_URL=https://detective-query.vercel.app
FRONTEND_URL=https://detective-query.vercel.app

# ── Runtime
NODE_ENV=production
